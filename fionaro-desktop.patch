diff --git a/nginx-fionaro-chat.conf b/nginx-fionaro-chat.conf
new file mode 100644
index 0000000000..a0702d1c28
--- /dev/null
+++ b/nginx-fionaro-chat.conf
@@ -0,0 +1,53 @@
+# Fionaro Chat Web — nginx config
+# Deploy to: /etc/nginx/sites-available/fionaro-chat
+# Then: ln -s /etc/nginx/sites-available/fionaro-chat /etc/nginx/sites-enabled/
+#       certbot --nginx -d chat.fionaro.pw
+#       systemctl reload nginx
+
+server {
+    listen 80;
+    server_name chat.fionaro.pw;
+    return 301 https://$host$request_uri;
+}
+
+server {
+    listen 443 ssl http2;
+    server_name chat.fionaro.pw;
+
+    # certbot will add these lines:
+    # ssl_certificate     /etc/letsencrypt/live/chat.fionaro.pw/fullchain.pem;
+    # ssl_certificate_key /etc/letsencrypt/live/chat.fionaro.pw/privkey.pem;
+
+    root /var/www/fionaro-chat;
+    index index.html;
+
+    # SPA fallback — todas las rutas al index.html
+    location / {
+        try_files $uri $uri/ /index.html;
+    }
+
+    # Bundles con hash inmutable (1 año)
+    location /bundles/ {
+        expires 1y;
+        add_header Cache-Control "public, immutable";
+    }
+
+    # Config.json — no cachear
+    location = /config.json {
+        expires -1;
+        add_header Cache-Control "no-cache";
+    }
+
+    # Manifest e iconos
+    location /vector-icons/ {
+        expires 30d;
+    }
+    location = /manifest.json {
+        expires 7d;
+    }
+
+    # Cabeceras de seguridad
+    add_header X-Frame-Options "SAMEORIGIN" always;
+    add_header X-Content-Type-Options "nosniff" always;
+    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
+}
